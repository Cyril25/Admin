// ============================================================
// RÈGLES DE SÉCURITÉ FIRESTORE — Hub O'Fil du Doubs
// ============================================================
// C'est ICI qu'est la vraie barrière. Le JavaScript des pages ne fait
// que masquer des boutons : le dépôt est public, n'importe qui peut
// lire le code et appeler Firestore à la main. Ces règles, elles, sont
// appliquées par Google côté serveur et ne se contournent pas.
//
// Déploiement (console Firebase) :
//   1. https://console.firebase.google.com → projet ofildudoubs-hub
//   2. Firestore Database → onglet « Règles »
//   3. Copier-coller ce fichier, puis « Publier »
//
// ⚠ AJOUTER UN PROJET = AJOUTER UN BLOC ICI.
// Sans son bloc `match`, une collection tombe dans le catch-all final
// et reste inaccessible à tout le monde, superadmin compris.
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identité de l'appelant ---------------------------------

    function connecte() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }

    // Les documents membres ont pour identifiant l'email en minuscules.
    function idAppelant() {
      return request.auth.token.email.lower();
    }

    function existeMembre() {
      return connecte()
          && exists(/databases/$(database)/documents/membres/$(idAppelant()));
    }

    function docMembre() {
      return get(/databases/$(database)/documents/membres/$(idAppelant())).data;
    }

    function membreActif() {
      return existeMembre() && docMembre().actif == true;
    }

    // --- Filet de sécurité --------------------------------------
    // Le propriétaire est superadmin *par son adresse*, indépendamment
    // de la collection membres. Sans ça, supprimer ou désactiver son
    // propre document membre par erreur verrouillerait la base pour
    // toujours : plus personne ne pourrait la rouvrir, puisque seul un
    // superadmin peut écrire dans membres.
    function proprietaire() {
      return connecte() && idAppelant() == 'cyril.samson41@gmail.com';
    }

    function superadmin() {
      return proprietaire() || (membreActif() && docMembre().role == 'superadmin');
    }

    // Un membre accède à un projet si sa fiche le liste.
    function aAcces(projet) {
      return superadmin() || (membreActif() && projet in docMembre().projets);
    }

    // --- Annuaire des membres -----------------------------------
    // Lecture : le superadmin voit tout le monde (il gère les droits et
    // l'impersonation) ; un membre ne lit QUE sa propre fiche, ce dont
    // il a besoin pour construire son menu.
    // Écriture : superadmin uniquement — sinon n'importe qui pourrait
    // s'ajouter des projets ou se promouvoir superadmin.
    match /membres/{email} {
      allow read:  if superadmin() || (connecte() && email == idAppelant());
      allow write: if superadmin();
    }

    // --- Projets -------------------------------------------

    // Carnet d'idées : LECTURE PARTAGÉE, ÉCRITURE PERSONNELLE.
    //
    // Tout le monde lit tout — c'est le but d'un carnet commun, et c'est
    // le propriétaire qui lit les idées des autres pour les mettre en
    // place. Pas de cloisonnement en lecture, donc pas de `where`
    // obligatoire côté client, contrairement à `fournisseurs`.
    //
    // En écriture, chacun ne touche qu'à ses propres idées. `creePar`
    // porte l'email de l'auteur et sert de titre de propriété.
    match /idees/{document} {
      allow read: if aAcces('idees');

      // On ne crée que sous son propre nom. Comparé au jeton réel, donc
      // une idée saisie pendant une impersonation est enregistrée au nom
      // de qui la saisit vraiment.
      allow create: if aAcces('idees')
                    && request.resource.data.creePar == idAppelant();

      // Le superadmin corrige tout : c'est lui qui trie et met en œuvre.
      // Les autres ne modifient que les leurs, et ne peuvent pas changer
      // l'auteur — sans cette clause on pourrait refiler une idée.
      allow update: if superadmin()
                    || (aAcces('idees')
                        && resource.data.creePar == idAppelant()
                        && request.resource.data.creePar == resource.data.creePar);

      allow delete: if superadmin()
                    || (aAcces('idees') && resource.data.creePar == idAppelant());
    }

    match /exterieur/{document} {
      allow read, write: if aAcces('exterieur');
    }

    // Suivi des achats de collections.ofildudoubs.fr. Ce site est un
    // AUTRE dépôt, mais le même projet Firebase : ses collections se
    // déclarent donc ici, comme celles du hub. Le propriétaire y accède
    // par son statut de superadmin ; le jour où quelqu'un d'autre doit
    // y entrer, il faudra lui cocher le projet « achats » sur sa fiche.
    // ⚠ À CLOISONNER PAR PROPRIÉTAIRE — décidé le 30/07/2026, pas fait.
    // Les achats ne sont pas communs : chacun gère les siens, et chaque
    // ligne doit être rattachée au membre qui l'a créée. Le patron est
    // celui du bloc `fournisseurs` juste en dessous, à copier tel quel.
    // En l'état, toute personne ayant le droit `achats` voit et modifie
    // les lignes de tout le monde.
    match /achats/{document} {
      allow read, write: if aAcces('achats');
    }

    // Fournisseurs et comptes du site Collections — un seul tiroir pour
    // les deux, discriminé par un champ `type`.
    //
    // ⚠ CE BLOC PROTÈGE DES MOTS DE PASSE EN CLAIR. C'est la seule
    // barrière entre eux et le reste d'Internet : ne jamais l'élargir
    // « pour dépanner ».
    //
    // CHACUN CHEZ SOI. Le champ `proprietaire` porte l'email du détenteur,
    // et un membre ne voit que ses propres fiches. Le droit `fournisseurs`
    // ouvre donc la page, pas les identifiants des autres.
    //
    // ⚠ CONSÉQUENCE CÔTÉ CLIENT : une règle n'est PAS un filtre. Firestore
    // rejette en bloc toute requête qui pourrait ramener un document
    // interdit — la page doit donc interroger
    // `where('proprietaire', '==', <son email>)`. Sans ce `where`, elle
    // n'est pas partiellement vide : elle est totalement vide, avec une
    // erreur de permissions.
    //
    // Le superadmin lit tout, et c'est assumé : sans ça l'impersonation
    // n'afficherait rien, et il lit de toute façon la base depuis la
    // console Firebase. Ce qu'il ne peut pas faire, c'est s'attribuer les
    // fiches d'un autre sans que ça se voie.
    match /fournisseurs/{document} {
      allow read: if superadmin()
                  || (aAcces('fournisseurs')
                      && resource.data.proprietaire == idAppelant());

      allow create: if superadmin()
                    || (aAcces('fournisseurs')
                        && request.resource.data.proprietaire == idAppelant());

      // `proprietaire` est immuable : sans cette clause, un membre
      // pourrait pousser une de ses fiches chez quelqu'un d'autre.
      allow update: if superadmin()
                    || (aAcces('fournisseurs')
                        && resource.data.proprietaire == idAppelant()
                        && request.resource.data.proprietaire == resource.data.proprietaire);

      allow delete: if superadmin()
                    || (aAcces('fournisseurs')
                        && resource.data.proprietaire == idAppelant());
    }

    // --- Tout le reste est fermé --------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
